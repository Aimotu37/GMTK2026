  caseID: 1002
  caseName: "\u627E\u51FA\u8B66\u5BDF\u6B7B\u4EA1\u7684\u771F\u76F8\u3002 "
  sceneBg: "\u65C5\u9986\u5427\u53F0"
  storyLines:
  - text: " \u79BB\u5F00\u76D1\u72F1\u4EE5\u540E\uFF0C\u6211\u4EEC\u5728\u4E00\u95F4\u65C5\u9986\u843D\u811A\u3002\u6211\u8BF4\"\u6211\u4EEC\"\uFF0C\u662F\u6307\u6211\u548C\u8D1F\u8D23\u6211\u7684\u8B66\u5BDF\u2014\u2014\u4E00\u4E2A\u8FC7\u5206\u53E4\u677F\u7684\u5E74\u8F7B\u4EBA\uFF0C\u76F8\u5BF9\u4E8E\u4ED6\u7684\u5E74\u9F84\u800C\u8A00\u3002\u508D\u665A\uFF0C\u5C0F\u9547\u4E0A\u9010\u6E10\u88AB\u6D53\u96FE\u7B3C\u7F69\uFF0C\u65C5\u9986\u4EFF\u4F5B\u6210\u4E86\u53E6\u5916\u4E00\u5EA7\u5B64\u5C9B\u3002\u6211\u5728\u5427\u53F0\u5F85\u4E86\u8BB8\u4E45\uFF0C\u4E5F\u4E0D\u89C1\u90A3\u4E2A\u5C0F\u8B66\u5BDF\u8BF7\u6211\u559D\u4E00\u676F\uFF0C\u8FDE\u5E97\u91CC\u5C61\u5C61\u5411\u4ED6\u732E\u6BB7\u52E4\u7684\u5973\u9152\u4FDD\u4E5F\u6CA1\u6709\u5F97\u5230\u56DE\u5E94\u3002\u5C31\u5728\u6211\u611F\u5230\u6CA1\u8DA3\u51C6\u5907\u4F11\u606F\u65F6\uFF0C\u7A97\u5916\u4F20\u6765\u4E86\u4E00\u58F0\u60E8\u53EB\u2014\u2014\u8FD9\u4E2A\u5E74\u8F7B\u7684\u8B66\u5BDF\u5012\u5728\u5730\u4E0A\uFF0C\u5DF2\u7ECF\u6CA1\u6709\u4E86\u5FC3\u8DF3\uFF0C\u56DB\u5468\u53EA\u6709\u6211\u4EEC\u81EA\u5DF1\u7684\u811A\u5370\u3002"
    showPortrait: 0
    portrait: {fileID: 0}
  truthLines:
  - text: "\u8B66\u5BDF\u7531\u4E8E\u667A\u9F7F\u53D1\u708E\u6B63\u5728\u670D\u7528\u6D88\u708E\u836F\uFF0C\u5973\u9152\u4FDD\u5C06\u4ED6\u7684\u996E\u6599\u6362\u6210\u4E86\u9152\uFF0C\u5BFC\u81F4\u8B66\u5BDF\u4E2D\u6BD2\u5934\u6655\u79BB\u5F00\u9152\u9986\uFF0C\u5012\u5730\u8EAB\u4EA1\u3002\u7531\u4E8E\u6D53\u96FE\u548C\u6E7F\u5EA6\uFF0C\u73B0\u573A\u7684\u811A\u5370\u88AB\u63A9\u76D6\u4E86\u3002"
    showPortrait: 1
    portrait: {fileID: 21300000, guid: 0710168d6f6c28242893565aa03e77e4, type: 3}
