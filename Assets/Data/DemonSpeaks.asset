  m_Script: {fileID: 11500000, guid: a48d65f3bb24a1643bc848cbc71b42da, type: 3}
  m_Name: DemonSpeaks
  m_EditorClassIdentifier: 
  demonSpeakDatas:
  - id: 2001
    defaultSpeak: "\u6211\u5F88\u671F\u5F85\uFF0C\u8FD9\u4E00\u6B21\u53C8\u8981\u4E0A\u6F14\u4EC0\u4E48\u6837\u7684\u95F9\u5267\uFF1F"
    hurtSpeak: "\u4F60\u8FD9\u662F\u5728\u706B\u4E2D\u53D6\u6817\uFF0C\u4EB2\u7231\u7684\uFF0C\u4F60\u89C9\u5F97\u4F60\u7684\u597D\u8FD0\u80FD\u6301\u7EED\u591A\u4E45\uFF1F"
    defeatSpeak: "\u4F60\u4F1A\u540E\u6094\u7684\uFF0C\u4F60\u4F1A\u975E\u5E38\uFF0C\u975E\u5E38\u540E\u6094\uFF0C\u6211\u4FDD\u8BC1\u3002"
    mockSpeak: "\u54C8\uFF0C\u4F60\u6323\u624E\u7684\u6837\u5B50\u771F\u8BA9\u6211\u611F\u52A8\u2026\u2026"
    duration: 10
  - id: 2002
    defaultSpeak: "\u4F60\u662F\u5BF9\u7684\uFF0C\u54B1\u4EEC\u662F\u65F6\u5019\u627E\u70B9\u4E50\u5B50\u4E86\u3002"
    hurtSpeak: "\u597D\u5427\uFF0C\u5076\u5C14\u7ED9\u4F60\u4E00\u4E2A\u5C0F\u5C0F\u7684\u751C\u5934\u4E5F\u4E0D\u7B97\u592A\u574F\u3002"
    defeatSpeak: "\u4F60\u4EE5\u4E3A\u8FD9\u5C31\u7ED3\u675F\u4E86\u5417\uFF0C\u4E0D\uFF0C\u5B9D\u8D1D\uFF0C\u90A3\u4E9B\u68A6\u9B47\u6C38\u8FDC\u4E0D\u4F1A\u653E\u8FC7\u4F60\uFF0C\u5B83\u4EEC\u4F1A\u50CF\u662F\u4E0D\u5B89\u5206\u7684\u9AA8\u5934\uFF0C\u54AF\u5431\u54AF\u5431\u54CD\u4E2A\u4E0D\u505C\uFF0C\u7F20\u7740\u4F60\u3001\u6298\u78E8\u4F60\uFF0C\u6C38\u8FDC\u3001\u6C38\u8FDC\u2026\u2026"
    mockSpeak: "\u73B0\u5728\u8BA4\u8F93\u8FD8\u6765\u5F97\u53CA\uFF0C\u522B\u62C5\u5FC3\uFF0C\u6211\u559C\u6B22\u8BC6\u65F6\u52A1\u7684\u4EBA\u3002"
    duration: 10
  - id: 2003
    defaultSpeak: "\u7C97\u964B\u7684\u9648\u8BBE\u3001\u8E69\u811A\u7684\u914D\u89D2\uFF0C\u6211\u4EEC\u7684\u4E3B\u4EBA\u516C\u8981\u600E\u4E48\u5728\u8FD9\u6837\u7684\u821E\u53F0\u4E0A\u5927\u653E\u5F02\u5F69\u5462\uFF1F"
    hurtSpeak: "\u522B\u9AD8\u5174\u5F97\u592A\u65E9\u4E86\uFF0C\u6211\u4EEC\u6765\u65E5\u65B9\u957F\u5462\u3002"
    defeatSpeak: "\u5475\u5475\uFF0C\u4F60\u9003\u4E0D\u6389\u7684\uFF0C\u547D\u8FD0\u7684\u7EF3\u7D22\u5DF2\u7ECF\u52D2\u4F4F\u4E86\u4F60\u7684\u54BD\u5589\uFF0C\u4E00\u5207\u90FD\u662F\u5F92\u52B3\uFF0C\u6211\u4EEC\u7EC8\u7A76\u4F1A\u5728\u5730\u72F1\u91CC\u518D\u89C1\u2026\u2026"
    mockSpeak: "\u522B\u602A\u6211\uFF0C\u4EB2\u7231\u7684\uFF0C\u8FD9\u90FD\u662F\u4F60\u81EA\u8BA8\u82E6\u5403\u3002"
    duration: 10
