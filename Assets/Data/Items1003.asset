  itemDatas:
  - itemID: 301
    caseID: 1003
    itemName: "\u9274\u5B9A\u4E66"
    clueText: "\u9274\u5B9A\u7ED3\u8BBA\u663E\u793A\uFF0C\u672C\u4EF6\u4E3A\u539F\u4F5C\u3002\u51FA\u81EA\u6700\u8FD1\u501F\u4F4F\u5728\u4F2F\u7235\u5E9C\u90B8\u7684\u9274\u5B9A\u5BB6\uFF0C\u5BF9\u753B\u4F5C\u4F5C\u8005\u4E86\u89E3\u751A\u591A\u3002"
    resPath: 
  - itemID: 302
    caseID: 1003
    itemName: "\u300A\u5723\u5B89\u4E1C\u5C3C\u7684\u8BF1\u60D1\u300B"
    clueText: "16\u4E16\u7EAA\u535A\u65AF\u7684\u8457\u540D\u753B\u4F5C\uFF0C\u5F62\u5236\u4E3A\u4E09\u8054\u53EF\u5F00\u5408\u796D\u575B\u753B\uFF0C\u5206\u4E3A\u4E2D\u8054\u3001\u5DE6\u7FFC\u3001\u53F3\u7FFC\uFF0C\u6BCF\u4E00\u8054\u753B\u4F5C\u5747\u5C3A\u5BF8\u5DE8\u5927\u2026\u2026\u5618\uFF0C\u6211\u53EA\u662F\u5728\u8BFB\u9274\u5B9A\u4E66\u4E0A\u7684\u5B57\u3002"
    resPath: 
  - itemID: 303
    caseID: 1003
    itemName: "\u516C\u7235\u4E00\u5BB6\u7684\u5168\u5BB6\u798F"
    clueText: "\u548C\u73B0\u5728\u7684\u4F2F\u7235\u5E9C\u76F8\u6BD4\u5C11\u4E86\u4E0D\u5C11\u4E1C\u897F\uFF0C\u4E5F\u8BB8\u4F2F\u7235\u5BB6\u4E0D\u50CF\u6211\u60F3\u8C61\u5730\u90A3\u4E48\u5BCC\u88D5\u3002"
    resPath: 
  - itemID: 304
    caseID: 1003
    itemName: "\u6E14\u5177\u6876"
    clueText: "\u6446\u653E\u5728\u95E8\u53E3\u7684\u6E14\u5177\u6876\uFF0C\u548C\u5B85\u90B8\u5185\u7684\u5176\u4ED6\u9648\u8BBE\u6709\u4E9B\u683C\u683C\u4E0D\u5165\u3002\u8BF4\u4E0D\u5B9A\u4F2F\u7235\u4E00\u5BB6\u6709\u9493\u9C7C\u7684\u72C2\u70ED\u7231\u597D\u8005\u3002"
    resPath: 
  - itemID: 305
    caseID: 1003
    itemName: "\u5C0F\u63A8\u8F66"
    clueText: "\u591A\u6BB5\u624B\u7535\u7B52\u3001\u624B\u6301\u653E\u5927\u955C\u3001\u5C0F\u578B\u504F\u5149\u955C\u2014\u2014\u5176\u4ED6\u7684\u6211\u90FD\u4E0D\u8BA4\u8BC6\u3002\u5F88\u6709\u8BF4\u670D\u529B\u7684\u9274\u5B9A\u5DE5\u5177\uFF0C\u4EE5\u81F3\u4E8E\u5B83\u7684\u4E3B\u4EBA\u62FF\u4E86\u4E00\u4E2A\u5C0F\u63A8\u8F66\u6765\u88C5\u5B83\u4EEC\u3002"
    resPath: 
