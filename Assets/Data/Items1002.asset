    itemName: "\u53E3\u888B\u91CC\u7684\u75C5\u5386"
    clueText: "\u667A\u9F7F\u53D1\u708E\uFF0C\u6309\u533B\u5631\u670D\u7528\u2026\u2026\uFF08\u540E\u9762\u770B\u4E0D\u6E05\u4E86\uFF09\u3002\u54C8\uFF0C\u96BE\u602A\u4ED6\u7684\u8BDD\u548C\u6211\u4E00\u6837\u5C11\u3002"
    resPath: 
  - itemID: 202
    caseID: 1002
    itemName: "\u767D\u8272\u7684\u7C89\u672B"
    clueText: "\u5427\u53F0\u4E0A\u6563\u843D\u7684\u767D\u8272\u7C89\u672B\uFF0C\u7C98\u5728\u624B\u6307\u4E0A\u8214\u4E86\u8214\uFF0C\u5473\u9053\u5F88\u53E4\u602A\uFF0C\u770B\u6765\u4ED6\u4EEC\u6CA1\u6709\u505A\u76D0\u8FB9\u739B\u683C\u4E3D\u7279\u3002"
    resPath: 
  - itemID: 203
    caseID: 1002
    itemName: "\u9152\u676F"
    clueText: "\u9152\u676F\u91CC\u6B8B\u7559\u7740\u7C89\u7EA2\u8272\u7684\u6DB2\u4F53\u3002\u4F0F\u7279\u52A0\uFF0C\u8FD8\u6709\u2026\u2026\u5F88\u6D53\u7684\u679C\u9999\u3002"
    resPath: 
  - itemID: 204
    caseID: 1002
    itemName: "\u7A97\u6237"
    clueText: "\u6D53\u96FE\u63A9\u76D6\u4E86\u4E00\u5207\uFF0C\u7A7A\u6C14\u91CC\u6F6E\u6E7F\u53C8\u9ECF\u817B\u3002\u800C\u6211\u4EEC\uFF0C\u88AB\u56F0\u5728\u4E86\u8FD9\u91CC\uFF0C\u5728\u96FE\u6563\u4EE5\u524D\uFF0C\u8C01\u4E5F\u4E0D\u4F1A\u6765\u3002\u8FD9\u5230\u5E95\u662F\u597D\u4E8B\u8FD8\u662F\u574F\u4E8B\u5462\uFF1F"
    resPath: 
  - itemID: 205
    caseID: 1002
    itemName: "\u624B\u67AA"
    clueText: "\u8B66\u5BDF\u8EAB\u4EFD\u7684\u8C61\u5F81\u3002\u68C0\u67E5\u8FC7\u819B\u7EBF\u548C\u5F39\u5323\uFF0C\u6CA1\u6709\u4F7F\u7528\u8FC7\u7684\u8FF9\u8C61\u3002\u4E0D\u8FC7\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\uFF0C\u8FD8\u662F\u653E\u5728\u5927\u5BB6\u90FD\u80FD\u770B\u89C1\u7684\u5730\u65B9\u4E3A\u5999\u3002"
    resPath: 
