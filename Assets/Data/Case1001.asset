  caseID: 1001
  caseName: "\u627E\u5230\u9A6C\u514B\u9003\u8131\u5B64\u5C9B\u7684\u65B9\u5F0F\u3002"
  sceneBg: "\u5DE5\u4F5C\u95F4"
  storyLines:
  - text: "\u8FD9\u91CC\u662F\u4E00\u7247\u5B64\u5C9B\uFF0C\u88AB\u7EC8\u5E74\u4F4E\u6E29\u7684\u6D77\u6C34\u5305\u56F4\u7740\uFF0C\u6CA1\u6709\u6865\u6881\uFF0C\u552F\u4E00\u53EF\u4EE5\u79BB\u5F00\u7684\u9014\u5F84\u6B66\u88C5\u5DE1\u903B\u6E21\u8239\u3002\u201C\u6076\u9B54\u7684\u76D1\u72F1\u201D\uFF0C\u7B49\u5F85\u56DA\u72AF\u4EEC\u7684\u53EA\u6709\u7EC8\u8EAB\u7684\u76D1\u7981\u3002\u3000\u3000\u7136\u800C\u5C31\u5728\u6628\u5929\uFF0C\u76D1\u72F1\u7684\u8B66\u94C3\u54CD\u4E86\u4E00\u6574\u591C\uFF0C\u6211\u7684\u72F1\u53CB\uFF0C\u9A6C\u514B\uFF0C\u6316\u5F00\u901A\u98CE\u7BA1\u9053\u8D8A\u72F1\u4E86\uFF0C\u7559\u5728\u4ED6\u5E8A\u4E0A\u7684\u53EA\u6709\u4E00\u4E2A\u7C97\u5236\u6EE5\u9020\u7684\u4EFF\u771F\u5047\u4EBA\u3002\r"
    showPortrait: 0
    portrait: {fileID: 0}
  truthLines:
  - text: "\u9A6C\u514B\u7528\u9A6C\u8FBE\u6539\u88C5\u94BB\u5934\u6316\u5F00\u901A\u98CE\u7BA1\u9053\uFF0C\u7528\u6253\u78E8\u597D\u7684\u52FA\u5B50\u78E8\u5236\u8239\u6868\uFF0C\u901A\u8FC7\u84B8\u6C7D\u6C5F\u7C98\u5408\u6A61\u80F6\u96E8\u8863\u505A\u6210\u7B4F\u5B50\u548C\u6551\u751F\u8863\uFF0C\u518D\u4EE5\u624B\u98CE\u7434\u6539\u88C5\u5145\u6C14\u6CF5\u4E3A\u7B4F\u5B50\u5145\u6C14\uFF0C\u6700\u540E\u4E58\u8239\u9003\u79BB\u3002\r"
    showPortrait: 1
    portrait: {fileID: 21300000, guid: 0710168d6f6c28242893565aa03e77e4, type: 3}
